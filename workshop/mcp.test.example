import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { createInterface } from "node:readline";
import { test } from "node:test";

test("read-only MCP tool exposes only synthetic earnings", async () => {
  const server = spawn(process.execPath, ["src/mcp-server.mjs"], {
    cwd: new URL("..", import.meta.url),
    stdio: ["pipe", "pipe", "pipe"]
  });
  const lines = createInterface({ input: server.stdout })[Symbol.asyncIterator]();
  try {
    async function call(id, method, params) {
      server.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params })}\n`);
      const { value, done } = await lines.next();
      assert.equal(done, false);
      return JSON.parse(value);
    }
    assert.equal((await call(1, "initialize")).result.serverInfo.name,
      "abingdon-synthetic-earnings");
    assert.equal((await call(2, "tools/list")).result.tools[0].name,
      "get_driver_earnings");
    const earnings = await call(3, "tools/call", {
      name: "get_driver_earnings", arguments: { driverId: "driver-101" }
    });
    assert.match(earnings.result.content[0].text, /"earningsGbp":672/);
    assert.equal((await call(4, "tools/call", {
      name: "get_driver_earnings", arguments: { driverId: "missing" }
    })).result.isError, true);
    assert.equal((await call(5, "tools/call", {
      name: "update_driver_earnings", arguments: { driverId: "driver-101" }
    })).error.code, -32601);
  } finally {
    server.kill();
  }
});
